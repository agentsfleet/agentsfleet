#!/usr/bin/env bash
# Pre-push: fast smoke verification. Heavy lanes live in Continuous Integration
# (CI).
#
# Stage shape:
#   1. classify pushed files (since upstream / main fork-point) into 5 flags
#   2. run matching test-unit-* lanes — cargo backgrounded, JavaScript serial
#
# No `orly gate` call: `work` proves nothing here (see below), and `pr` is the
# comprehensive tier that belongs at CHORE(close).
#
# Surfaces:
#   - lint-rustd + test-unit-rustd (*.rs, rustd/*)
#   - test-unit-cli            (cli/*)
#   - test-unit-website        (ui/packages/website/*)
#   - test-unit-app            (ui/packages/app/*, design-system/* triggers both)
#   - test-unit-design-system  (ui/packages/design-system/*)
#
# `lint-rustd` runs HERE rather than at commit time, and that is the tiering
# docs/VERIFY_TIERS.md already describes: the `conform` row is pre-commit's and
# costs seconds, the lint and unit rows are pre-push's. Clippy over the whole
# workspace is 36s to 3m16s — measured across six commits on one branch — and
# charging that to every commit is what makes a developer batch unrelated work
# into one large commit to avoid paying it twice. Once per push covers exactly
# the same commits before anything leaves the machine.
#
# Pre-push is the fast-smoke floor; Continuous Integration (CI) is the
# comprehensive gate. The split exists because the prior behaviour held the
# Secure Shell (SSH) session idle during the heavier lanes, which github.com
# routinely dropped at pack-write time even though every test passed locally.
# Any lane needing live datastores belongs on the CI side of that line.
#
# There is no Zig dispatch here. The Zig integration and memory-leak lanes
# retired with the rest of the Zig gating, and the daemon itself is frozen —
# `*.zig` reaches only `check-documentation-rules` in pre-commit, which reads
# command help text out of that source.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# --- progress reporting ------------------------------------------------------
# The Rust lanes are backgrounded into a log so their output cannot interleave
# with the JavaScript ones, which is right — but it also meant the longest part
# of a push (36s to 3m16s of clippy plus the unit suite) printed one line and
# then went silent. A developer cannot tell a slow lane from a wedged one, so
# the wait below prints a heartbeat carrying elapsed time and the log's last
# line. `date +%s` rather than bash 5's `EPOCHSECONDS`: a fresh clone on a Mac
# without homebrew bash runs /bin/bash 3.2.
hook_started_at="$(date +%s)"

# Seconds as `12s` under a minute and `2m04s` above it — a bare second count
# stops being readable at exactly the durations this hook spends most of its
# time in.
fmt_elapsed() {
  local secs="$1"
  if [ "$secs" -lt 60 ]; then
    printf '%ds' "$secs"
  else
    printf '%dm%02ds' "$((secs / 60))" "$((secs % 60))"
  fi
}

since() { printf '%s' "$(fmt_elapsed "$(( $(date +%s) - $1 ))")"; }

# --- no orly gate here, deliberately -----------------------------------------
# This hook used to run `orly gate work`. orly 0.8.0 recomposed its gates
# one-per-cadence, and `work` now runs the repository's declared `conform`
# command — which here is `make harness-verify`, and harness-verify is
# STAGED-scoped. Nothing is staged at push time, so all nine audits printed
# "no files in scope" and the call cost ~3s to prove nothing about the commits
# being pushed.
#
# Dropping it loses no coverage: `conform` already ran against every one of
# those commits, at commit time, in .githooks/pre-commit — over the staged diff
# that actually became the commit, which is the only scope where a staged-diff
# audit means anything. Re-asking at push can only re-answer for an empty set.
#
# The whole-worktree answer (`make harness-verify-all`) is a different and
# strictly larger question — it grades untouched pre-existing debt, not this
# push — and belongs to `orly gate pr` at CHORE(close) and to Continuous
# Integration (CI), both of which run it. `orly gate pr` also remains the
# comprehensive tier this hook deliberately leaves alone: running it here would
# hold the push open for the stretch github.com kept dropping.

if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  upstream_ref='@{u}'
else
  # No upstream yet (first push of this branch) — gate against main fork-point.
  upstream_ref="$(git merge-base HEAD main 2>/dev/null || git rev-list --max-parents=0 HEAD)"
fi

pushed_files="$(git diff --name-only "$upstream_ref"..HEAD 2>/dev/null || true)"

# The odd name in this list: it gates BOTH `lint-rustd` and `test-unit-rustd`,
# where its siblings gate one lane each. One flag because one file pattern
# answers both questions — a Cargo manifest or the toolchain pin changes what
# clippy compiles and what the tests compile, identically.
needs_rustd=0
needs_test_cli=0
needs_test_website=0
needs_test_app=0
needs_test_design_system=0

while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    *.rs|rustd/*)
      needs_rustd=1 ;;
    cli/*)
      needs_test_cli=1 ;;
    ui/packages/website/*)
      needs_test_website=1 ;;
    ui/packages/app/*)
      needs_test_app=1 ;;
    ui/packages/design-system/*)
      # Design system is consumed by app — test both when design-system changes.
      needs_test_design_system=1
      needs_test_app=1 ;;
  esac
done <<< "$pushed_files"

any_needed=$(( needs_rustd + needs_test_cli + needs_test_website + needs_test_app + needs_test_design_system ))

pushed_count="$(printf '%s\n' "$pushed_files" | grep -c . || true)"
echo "▶ pre-push: $pushed_count changed file(s) since $upstream_ref"

if [ "$any_needed" -eq 0 ]; then
  echo "  no test-relevant files — nothing to run"
  exit 0
fi

# The plan, before anything runs: a developer who knows which lanes were
# selected can tell "still going" from "picked the wrong lane" without waiting
# for the answer.
plan=""
[ "$needs_rustd"              = 1 ] && plan="$plan lint-rustd+test-unit-rustd"
[ "$needs_test_cli"           = 1 ] && plan="$plan test-unit-cli"
[ "$needs_test_website"       = 1 ] && plan="$plan test-unit-website"
[ "$needs_test_app"           = 1 ] && plan="$plan test-unit-app"
[ "$needs_test_design_system" = 1 ] && plan="$plan test-unit-design-system"
echo "  lanes:$plan"

# --- Test lanes --------------------------------------------------------------
# Split by RESOURCE CLASS, not by "parallel vs serial".
#
# The JavaScript lanes are browser (jsdom/vitest) and pseudo-terminal (the CLI
# help-e2e tests spawn the built binary and wait on its output). Those fight
# each other for local runtime: launching all of them at once is what made the
# CLI lane flake badly enough to earn its `--timeout 30000` (see
# make/test-unit.mk). They stay serial among themselves, exactly as before.
#
# The Rust lanes are cargo — no jsdom, no PTY, no bun. They contend with the
# JavaScript lanes for CPU alone, which is what a machine's scheduler is for.
# So they start FIRST, in the background, and are waited on at the end: when a
# push touches both Rust and JavaScript surfaces, the whole Rust side overlaps
# the JavaScript ones for free. When a push touches only one class — the common
# case — behaviour is bit-for-bit what it was.
#
# `lint-rustd` and `test-unit-rustd` run as ONE make invocation without `-j`,
# so they are serial with respect to each other. That is not a missed
# parallelism: both are cargo over one target directory and would serialize on
# cargo's own build lock anyway, so `-j` would buy contention rather than
# overlap. Lint is first because it is the cheaper failure — a clippy error
# should not wait out a unit suite to be reported.
failed_names=()

run_lane() {
  local name="$1"; shift
  local lane_started_at
  lane_started_at="$(date +%s)"
  echo "→ $name: $*"
  if ! "$@"; then
    failed_names+=("$name")
    echo "✗ $name failed after $(since "$lane_started_at")"
  else
    echo "✓ $name ($(since "$lane_started_at"))"
  fi
}

rustd_pid=""
rustd_log=""
if [ "$needs_rustd" = 1 ]; then
  rustd_log="$(mktemp)"
  echo "pre-push: make lint-rustd test-unit-rustd (background — overlaps the JavaScript lanes)"
  make lint-rustd test-unit-rustd >"$rustd_log" 2>&1 &
  rustd_pid="$!"
fi

# Serial among themselves: same order, same isolation as before.
[ "$needs_test_cli"           = 1 ] && run_lane test-unit-cli                make test-unit-cli
[ "$needs_test_website"       = 1 ] && run_lane test-unit-website            make test-unit-website
[ "$needs_test_app"           = 1 ] && run_lane test-unit-app                make test-unit-app
[ "$needs_test_design_system" = 1 ] && run_lane test-unit-design-system      make test-unit-design-system

if [ -n "$rustd_pid" ]; then
  echo "→ waiting on the Rust lanes (output replays below when they finish)"
  # Poll rather than block straight into `wait`, so the heartbeat can report
  # elapsed time and the log's last line every 10s. `kill -0` in a `while`
  # condition is exempt from `set -e`, and bash holds a terminated child's
  # status until `wait` collects it — so the status below is still the lane's.
  rustd_waited=0
  while kill -0 "$rustd_pid" 2>/dev/null; do
    sleep 2
    rustd_waited=$(( rustd_waited + 2 ))
    if [ "$(( rustd_waited % 10 ))" -eq 0 ]; then
      rustd_last="$(tail -n 1 "$rustd_log" 2>/dev/null | tr -d '\r' | cut -c1-90)"
      echo "   … rustd $(fmt_elapsed "$rustd_waited") — ${rustd_last:-compiling}"
    fi
  done
  if ! wait "$rustd_pid"; then
    # One name for both: make stops at the first failing target, and the log
    # replayed below names which one it was.
    failed_names+=(lint-rustd/test-unit-rustd)
    echo "✗ lint-rustd/test-unit-rustd failed after $(fmt_elapsed "$rustd_waited")"
  else
    echo "✓ lint-rustd/test-unit-rustd ($(fmt_elapsed "$rustd_waited"))"
  fi
  cat "$rustd_log"
  rm -f "$rustd_log"
fi

if [ "${#failed_names[@]}" -gt 0 ]; then
  echo "✗ pre-push: failed lanes — ${failed_names[*]} (after $(since "$hook_started_at"))"
  exit 1
fi

echo "✔ pre-push passed in $(since "$hook_started_at")"
exit 0
