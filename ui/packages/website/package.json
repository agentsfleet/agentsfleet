{
  "name": "agentsfleet-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run prebuild && vite",
    "prebuild": "bun ./scripts/prebuild.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tests/e2e playwright.config.ts",
    "lint:fix": "oxlint src tests/e2e playwright.config.ts --fix",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:smoke": "playwright test --workers=1 tests/e2e/smoke.spec.ts",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit"
  },
  "dependencies": {
    "@agentsfleet/design-system": "workspace:*",
    "posthog-js": "^1.409.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.62.1",
    "@size-limit/preset-app": "13.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "30.0.1",
    "oxlint": "^1.76.0",
    "size-limit": "13.0.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  }
}
