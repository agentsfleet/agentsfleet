{
  "name": "agentsfleet-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run prebuild && vite",
    "prebuild": "bun ./scripts/prebuild.mjs",
    "build": "bun run --bun tsrs -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tests/e2e playwright.config.ts",
    "lint:fix": "oxlint src tests/e2e playwright.config.ts --fix",
    "typecheck": "bun run --bun tsrs -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:smoke": "playwright test --workers=1 tests/e2e/smoke.spec.ts",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit"
  },
  "dependencies": {
    "@agentsfleet/design-system": "workspace:*",
    "posthog-js": "^1.447.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@size-limit/preset-app": "14.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "31.0.0",
    "oxlint": "^1.93.0",
    "size-limit": "14.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "1.4.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
