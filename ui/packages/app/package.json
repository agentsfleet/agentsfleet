{
  "name": "agentsfleet-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "bun run typecheck && next build",
    "size": "size-limit",
    "start": "next start",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "test": "vitest run",
    "test:e2e": "bunx playwright test",
    "test:e2e:smoke": "bunx playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:acceptance": "bunx playwright test --config=playwright.acceptance.config.ts",
    "test:e2e:acceptance:preflight": "bunx playwright test --config=playwright.acceptance.config.ts --project=preflight",
    "test:e2e:acceptance:journeys": "bunx playwright test --config=playwright.acceptance.config.ts --project=journeys",
    "test:e2e:acceptance:operator": "bunx playwright test --config=playwright.acceptance.config.ts --project=operator-journey",
    "test:e2e:acceptance:execution": "bunx playwright test --config=playwright.acceptance.config.ts --project=journeys tests/e2e/acceptance/fleet-execution.spec.ts",
    "test:e2e:acceptance:local": "NEXT_PUBLIC_API_URL=http://localhost:3000 bunx playwright test --config=playwright.acceptance.config.ts",
    "test:e2e:acceptance:dev": "BASE_URL=https://app-dev.agentsfleet.net NEXT_PUBLIC_API_URL=https://api-dev.agentsfleet.net bunx playwright test --config=playwright.acceptance.config.ts",
    "test:e2e:acceptance:prod": "BASE_URL=https://app.agentsfleet.net NEXT_PUBLIC_API_URL=https://api.agentsfleet.net bunx playwright test --config=playwright.acceptance.config.ts",
    "qa": "bun run test && bun run test:e2e",
    "test:coverage": "vitest run --coverage",
    "qa:smoke": "bun run test:e2e:smoke"
  },
  "dependencies": {
    "@agentsfleet/design-system": "workspace:*",
    "@assistant-ui/react": "^0.15.30",
    "@clerk/nextjs": "^7.9.19",
    "@clerk/ui": "^1.41.1",
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "diff": "^9.0.0",
    "effect": "4.0.5",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "posthog-js": "^1.438.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@clerk/testing": "^2.2.49",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "happy-dom": "21.0.4",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "size-limit": "14.2.0",
    "svix": "^2.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
