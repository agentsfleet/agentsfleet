{
  "name": "agentsfleet-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "bun run typecheck && next build",
    "size": "size-limit",
    "start": "next start",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "test": "vitest run",
    "test:smoke": "vitest run tests/smoke.test.ts",
    "test:e2e": "bunx playwright test",
    "test:e2e:smoke": "bunx playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:acceptance": "bunx playwright test --config=playwright.acceptance.config.ts",
    "test:e2e:acceptance:preflight": "bunx playwright test --config=playwright.acceptance.config.ts --project=preflight",
    "test:e2e:acceptance:journeys": "bunx playwright test --config=playwright.acceptance.config.ts --project=journeys",
    "test:e2e:acceptance:operator": "bunx playwright test --config=playwright.acceptance.config.ts --project=operator-journey",
    "test:e2e:acceptance:execution": "bunx playwright test --config=playwright.acceptance.config.ts --project=journeys tests/e2e/acceptance/fleet-execution.spec.ts",
    "test:e2e:acceptance:local": "NEXT_PUBLIC_API_URL=http://localhost:3000 bunx playwright test --config=playwright.acceptance.config.ts",
    "test:e2e:acceptance:dev": "BASE_URL=https://app-dev.agentsfleet.net NEXT_PUBLIC_API_URL=https://api-dev.agentsfleet.net bunx playwright test --config=playwright.acceptance.config.ts",
    "test:e2e:acceptance:prod": "BASE_URL=https://app.agentsfleet.net NEXT_PUBLIC_API_URL=https://api.agentsfleet.net bunx playwright test --config=playwright.acceptance.config.ts",
    "qa": "bun run test && bun run test:e2e",
    "test:coverage": "vitest run --coverage",
    "qa:smoke": "bun run test:smoke && bun run test:e2e:smoke"
  },
  "dependencies": {
    "@agentsfleet/design-system": "workspace:*",
    "@ai-sdk-tool/parser": "5.1.6",
    "@ai-sdk/provider": "4.0.18",
    "@ai-sdk/provider-utils": "5.0.47",
    "@assistant-ui/react": "^0.15.22",
    "@clerk/nextjs": "^7.9.6",
    "@clerk/ui": "^1.35.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "cron-parser": "^5.10.1",
    "effect": "4.0.0-rc.112",
    "htmlparser2": "12.0.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "posthog-js": "^1.434.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@clerk/testing": "^2.2.38",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-istanbul": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "happy-dom": "20.14.5",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "size-limit": "14.0.0",
    "svix": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "typescript-jsapi": "npm:typescript@6.0.2",
    "vitest": "5.0.1"
  }
}
