{
  "name": "agentsfleet-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --bun next dev --turbopack",
    "build": "bun run typecheck && bun run --bun next build",
    "size": "bun run --bun size-limit",
    "start": "bun run --bun next start",
    "typecheck": "bun run --bun tsrs --noEmit",
    "lint": "bun run --bun oxlint --type-aware .",
    "test": "bun run --bun vitest run",
    "test:e2e": "bunx --bun playwright test",
    "test:e2e:smoke": "bunx --bun playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:acceptance": "bunx --bun playwright test --config=playwright.acceptance.config.ts",
    "test:e2e:acceptance:preflight": "bunx --bun playwright test --config=playwright.acceptance.config.ts --project=preflight",
    "test:e2e:acceptance:journeys": "bunx --bun playwright test --config=playwright.acceptance.config.ts --project=journeys",
    "test:e2e:acceptance:operator": "bunx --bun playwright test --config=playwright.acceptance.config.ts --project=workspace-admin",
    "test:e2e:acceptance:execution": "bunx --bun playwright test --config=playwright.acceptance.config.ts --project=journeys tests/e2e/acceptance/prime-morning-rooster.spec.ts",
    "test:e2e:acceptance:local": "NEXT_PUBLIC_API_URL=http://localhost:3000 bunx --bun playwright test --config=playwright.acceptance.config.ts",
    "test:e2e:acceptance:dev": "BASE_URL=https://app-dev.agentsfleet.net NEXT_PUBLIC_API_URL=https://api-dev.agentsfleet.net bunx --bun playwright test --config=playwright.acceptance.config.ts",
    "test:e2e:acceptance:prod": "BASE_URL=https://app.agentsfleet.net NEXT_PUBLIC_API_URL=https://api.agentsfleet.net bunx --bun playwright test --config=playwright.acceptance.config.ts",
    "qa": "bun run test && bun run test:e2e",
    "test:coverage": "bun run --bun vitest run --coverage",
    "qa:smoke": "bun run test:e2e:smoke"
  },
  "dependencies": {
    "@agentsfleet/design-system": "workspace:*",
    "@assistant-ui/react": "0.15.38",
    "@assistant-ui/react-markdown": "0.14.26",
    "@clerk/nextjs": "^7.10.9",
    "@clerk/ui": "^1.45.0",
    "@hookform/resolvers": "^7.0.9",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-avatar": "1.3.1",
    "diff": "^9.0.0",
    "effect": "4.1.5",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "posthog-js": "^1.454.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "react-window": "2.5.4",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@clerk/testing": "^2.3.8",
    "@playwright/test": "1.65.1",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.8",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-istanbul": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "happy-dom": "21.0.4",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "postcss": "8.5.33",
    "size-limit": "14.3.0",
    "tailwindcss": "^4.3.5",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
