{
  "schema_version": 1,
  "orly_version": "0.28.0",
  "packs": [
    "language.rust",
    "persona.indy",
    "product.agentsfleet"
  ],
  "commands": {
    "verify.lint": [
      [
        "make",
        "lint-all"
      ]
    ],
    "verify.unit": [
      [
        "make",
        "test-unit-all"
      ]
    ],
    "verify.integration": [
      [
        "make",
        "test-integration-rustd"
      ]
    ],
    "verify.version": [
      [
        "make",
        "check-version"
      ]
    ]
  },
  "surfaces": {
    "user": [
      "cli/",
      "ui/packages/app/",
      "ui/packages/website/",
      "public/openapi/",
      "schema/"
    ],
    "docs": [
      "docs/",
      "README.md",
      "public/openapi/"
    ]
  },
  "managed": [
    ".agents/skills/orly-build/SKILL.md",
    ".agents/skills/orly-ship/SKILL.md",
    ".agents/skills/orly-spec/SKILL.md",
    ".claude/agents/orly-standards-reviewer.md",
    ".claude/skills/orly-build/SKILL.md",
    ".claude/skills/orly-ship/SKILL.md",
    ".claude/skills/orly-spec/SKILL.md",
    ".opencode/skills/orly-build/SKILL.md",
    ".opencode/skills/orly-ship/SKILL.md",
    ".opencode/skills/orly-spec/SKILL.md",
    ".orly/AGENTS.md",
    ".orly/skills/orly-build/SKILL.md",
    ".orly/skills/orly-ship/SKILL.md",
    ".orly/skills/orly-spec/SKILL.md",
    ".orly/standards/changelog.md",
    ".orly/standards/code.md",
    ".orly/standards/docs-pages.md",
    ".orly/standards/docs.md",
    ".orly/standards/domains/architecture.md",
    ".orly/standards/domains/auth.md",
    ".orly/standards/domains/http-responses.md",
    ".orly/standards/domains/http-surface.md",
    ".orly/standards/domains/http.md",
    ".orly/standards/domains/logging.md",
    ".orly/standards/domains/sql.md",
    ".orly/standards/languages/python.md",
    ".orly/standards/languages/rust.md",
    ".orly/standards/languages/shell.md",
    ".orly/standards/languages/typescript.md",
    ".orly/standards/pr.md",
    ".orly/standards/spec-template.md",
    ".orly/standards/spec.md",
    ".orly/standards/tests.md"
  ]
}
