# agentsfleet Runner — host-resident execution-plane daemon.
# Takes runs from the agentsfleetd control plane over HTTPS, runs each run's
# turn on its agent loop and that turn's tools in a Firecracker microVM of the
# run's own, and reports back. Holds zero datastore credentials.
#
# The host needs a Kernel-based Virtual Machine (KVM) device the runner can
# open at /dev/kvm; without one the runner exits at boot naming `kvm`, and
# starts no other engine. It reads the monitor, its jailer, the guest kernel
# and the guest's initial file system from /usr/local/bin/firecracker,
# /usr/local/bin/jailer, /usr/local/lib/agentsfleet/vmlinux and
# /usr/local/lib/agentsfleet/guest.cpio, unless `[firecracker]` in the runner's
# file names others.
#
# Install:
#   sudo cp agentsfleet-runner.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now agentsfleet-runner

[Unit]
Description=agentsfleet Runner
Documentation=https://docs.agentsfleet.net
After=network.target

[Service]
Type=simple
# The toolbox is an EROFS image, and the runner's probe reads /proc/filesystems,
# which lists erofs only once its module is loaded: a fresh or rebooted host
# would refuse at every start. `+` runs it with full privileges, whatever
# hardening this unit gains; `-` lets a host without modprobe, or with erofs
# built in, start anyway, and the probe names erofs if it is truly missing.
ExecStartPre=-+/usr/sbin/modprobe erofs
# `run` supervises this host's runs; the binary's other entries are `probe`
# and `guest`, which a microVM's kernel starts as its first process. The
# engine is named, though it is the default, so the unit says what it boots: a
# release build has no other, and a host it cannot boot on runs nothing.
ExecStart=/usr/local/bin/agentsfleet-runner run --engine firecracker
Restart=always
RestartSec=5
# 77 (EX_NOPERM, `EXIT_TOKEN_REFUSED` in agentsfleet_runner's host.rs) is the
# runner stopping because the control plane refused its token: the runner is
# cordoned, drained, revoked or deleted, and no restart changes that answer.
# Each restart would boot, admit the toolbox and dial again only to be
# refused. After an uncordon, start it again with
# `sudo systemctl restart agentsfleet-runner`.
RestartPreventExitStatus=77
# A stopped runner's in-flight run is reclaimed by the control plane
# (run_expires_at + fencing_token), so a bounded stop never loses or
# double-runs work; the timeout just lets an in-flight child finish.
# deploy.sh's DRAIN_TIMEOUT_SECONDS equals it (deploy_test.sh holds the pair).
TimeoutStopSec=300
KillMode=mixed

# Required runner config — provisioned per host into the env file below by the
# runner bootstrap playbook (never committed; the runner-token is a secret).
# The environment carries bootstrap and stream connection settings; everything else (sandbox
# tier, network policy, registry allowlist, worker count) is ASSIGNED by the
# control plane per runner and delivered with its identity — change it from
# the dashboard, never from this file:
#   AGENTSFLEET_API_URL       — agentsfleetd HTTPS API base, e.g. https://api.agentsfleet.net
#   AGENTSFLEET_RUNNER_STREAM_URL — private HTTPS origin, e.g. https://agentsfleetd-prod.internal:4443
#   AGENTSFLEET_RUNNER_STREAM_TLS_CA_CERT_FILE — public CA file installed by deployment
#   AGENTSFLEET_RUNNER_TOKEN  — pre-minted `agt_r…` token (Option B): the platform
#                          admin mints it via `POST /v1/runners` on the live
#                          control plane and stores it in 1Password under
#                          `…/agent-…-worker-ant/runner-token`; the daemon
#                          authenticates with it directly and NEVER self-registers.
#                          The token resolves the runner row server-side, so no
#                          host identifier is read from this file.
#   (optional) RUNNER_STORAGE_HOME — host-local root for run sandboxes, the
#                          report spool, the bundle cache and the toolbox (a disk
#                          fact the control plane cannot know); defaults to
#                          /var/lib/agentsfleet-runner when unset, which
#                          StateDirectory= below creates. A different root must
#                          exist and be added to ReadWritePaths below, which
#                          ProtectSystem=strict leaves read-only otherwise.
#   (optional) OTEL_EXPORTER_OTLP_ENDPOINT — the runner collector the runner
#                          exports its spans and metrics to; unset exports nothing
# Bootstrap order (chicken-and-egg): the updated agentsfleetd (with the platform-
# admin enrollment gate) must be deployed FIRST; only then can an admin mint a
# `agt_r` for this host. Until that's done, DEV_RUNNER_READY stays `false`.
EnvironmentFile=-/etc/default/agentsfleet-runner
Environment=AGENTSFLEET_RUNNER_CONFIG_FILE=/etc/agentsfleet/agentsfleet-runner.toml

# Each host publishes its own metric series: the exported resource carries
# service.instance.id, and %H is this host's name.
Environment=OTEL_SERVICE_INSTANCE_ID=%H

# The runner's lock on this host's egress objects lives here (`RUNTIME_DIR` in
# afr_firewall's lock.rs): a second runner started beside this one is refused
# at boot instead of sweeping this one's links.
RuntimeDirectory=agentsfleet
RuntimeDirectoryMode=0755

# systemd supplies no HOME to a service that declares no User=, so anything the
# runner starts on the host that resolves a configuration directory from HOME
# would find none. This value is the runner's own: it starts every jailer with
# an empty environment, so no monitor or guest inherits it. It points at
# the runtime directory above rather than a real home because ProtectHome=yes
# makes /root and /home unreadable here and ProtectSystem=strict leaves only the
# ReadWritePaths writable.
Environment=HOME=/run/agentsfleet

# Security hardening. The wall around a run's code is its microVM; this unit
# hardens the runner around it. The runner stays root with every capability,
# so the unit names no User= and no CapabilityBoundingSet=. At boot it attaches
# the toolbox image to a loop device and mounts it. For each microVM it makes a
# network namespace, with a tap and an nftables table when the run reaches a
# network, gives a jail a user of its own, and starts the jailer, which changes
# root into the jail, makes the monitor's device nodes there and only then
# drops to that user.
#
# It names no PrivateDevices=, DevicePolicy= or DeviceAllow= either. The
# runner opens /dev/kvm, /dev/net/tun and the loop devices, makes a block node
# for the toolbox in every jail, and the jailer makes the monitor's own nodes
# there, /dev/kvm and /dev/net/tun among them. A device list here that missed
# one would stop every boot.
#
# NoNewPrivileges= costs nothing: the jailer and the monitor are plain
# programs started by root, and neither gains a privilege by being run.
NoNewPrivileges=yes
ProtectSystem=strict
# Delegate only this service's subtree. The runner makes each monitor's cgroup
# leaf beneath it and starts the jailer inside that leaf; it never receives a
# writable host-wide cgroup mount. The host probe requires all four
# controllers (`afr_engine::REQUIRED_CONTROLLERS`): a monitor's leaf caps its
# guest's memory, processors and threads.
Delegate=cpu io memory pids
DelegateSubgroup=runner
IOAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
# The storage home holds every run's sandbox, the report spool, the bundle
# cache and the mounted toolbox, so it must be writable under ProtectSystem=strict.
# Each sandbox's directory holds its workspace image and the chroot the jailer
# starts its monitor in (`--chroot-base-dir`), so the file system under it must
# allow device nodes: on a `nodev` mount no monitor can open its /dev/kvm.
# StateDirectory= creates /var/lib/agentsfleet-runner (root, 0755) when it is
# missing, on a fresh host or after an operator wipes it, and makes it
# writable. A plain ReadWritePaths entry instead fails the unit with
# 226/NAMESPACE before the runner starts, so `StorageHome::open`
# (`afr_supervisor`), which makes the directories beneath it, never runs.
StateDirectory=agentsfleet-runner
ReadWritePaths=/run/agentsfleet /sys/fs/cgroup/system.slice/agentsfleet-runner.service /tmp
ProtectHome=yes

[Install]
WantedBy=multi-user.target
