# agentsfleet Runner — host-resident execution-plane daemon.
# Leases work from the agentsfleetd control plane over HTTPS, runs each event in a
# forked sandboxed child, and reports back. Holds zero datastore credentials.
#
# Install:
#   sudo cp agentsfleet-runner.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now agentsfleet-runner

[Unit]
Description=agentsfleet Runner
Documentation=https://docs.agentsfleet.net
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/agentsfleet-runner
Restart=always
RestartSec=5
# A stopped runner's in-flight lease is reclaimed by the control plane
# (lease_expires_at + fencing_token), so a bounded stop never loses or
# double-runs work; the timeout just lets an in-flight child finish.
TimeoutStopSec=300
KillMode=mixed

# Required runner config — provisioned per host into the env file below by the
# runner bootstrap playbook (never committed; the runner-token is a secret).
# The environment carries ONLY the bootstrap trio; everything else (sandbox
# tier, network policy, registry allowlist, worker count) is ASSIGNED by the
# control plane per runner and delivered with its identity — change it from
# the dashboard, never from this file:
#   AGENTSFLEET_API_URL       — agentsfleetd HTTPS API base, e.g. https://api.agentsfleet.net
#   AGENTSFLEET_RUNNER_TOKEN  — pre-minted `agt_r…` token (Option B): the platform
#                          admin mints it via `POST /v1/runners` on the live
#                          control plane and stores it in 1Password under
#                          `…/agent-…-worker-ant/runner-token`; the daemon
#                          authenticates with it directly and NEVER self-registers.
#                          The token resolves the runner row server-side, so no
#                          host identifier is read from this file.
#   (optional) RUNNER_STORAGE_HOME — host-local root for per-lease scratch
#                          workspaces and the bundle cache (a disk fact the
#                          control plane cannot know); defaults sanely when unset
# Bootstrap order (chicken-and-egg): the updated agentsfleetd (with the platform-
# admin enrollment gate) must be deployed FIRST; only then can an admin mint a
# `agt_r` for this host. Until that's done, DEV_WORKER_READY stays `false`.
EnvironmentFile=-/etc/default/agentsfleet-runner

# Ensure the sandbox runtime directory exists.
RuntimeDirectory=agentsfleet
RuntimeDirectoryMode=0755

# systemd supplies no HOME to a service that declares no User=. This value is the
# DAEMON's only — it is deliberately not forwarded to the sandboxed child, and the
# comment that once claimed otherwise described the bug rather than the design.
# A child that inherited this path resolved its config directory onto
# /run/agentsfleet, which no bind list carries and no landlock rule covers, so
# every lease died at AccessDenied before its first model call. The child's home is
# assigned instead (contract.protocol.CHILD_HOME), on the per-lease tmpfs floor
# bwrap builds and landlock grants write to. It points at the runtime directory
# above rather than a real home because ProtectHome=yes makes /root and /home
# unreadable here and ProtectSystem=strict leaves only the ReadWritePaths writable.
Environment=HOME=/run/agentsfleet

# Security hardening — the runner forks bwrap user-namespace sandboxes per lease
# (no suid needed). Mirrors the isolation the standalone sandbox sidecar carried before
# the engine folded into the runner.
NoNewPrivileges=yes
ProtectSystem=strict
# Delegate only this service's subtree. The daemon creates each execution cgroup
# beneath it; it never receives a writable host-wide cgroup mount.
Delegate=cpu memory pids
DelegateSubgroup=runner
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
ReadWritePaths=/run/agentsfleet /sys/fs/cgroup/system.slice/agentsfleet-runner.service /tmp
ProtectHome=yes

[Install]
WantedBy=multi-user.target
