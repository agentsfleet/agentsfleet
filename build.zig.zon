.{
    // `agentsfleetd` until the cutover, which is the binary this graph no longer
    // builds. What it builds is the shared `src/lib` tests the runner links by
    // source, and the incident-response harness.
    .name = .agentsfleet,
    .version = "0.51.0",
    .minimum_zig_version = "0.16.0",
    // Moved with the rename below: Zig derives the fingerprint from the package
    // name, and refuses the build when the two disagree. This value is the one
    // the toolchain named for `.agentsfleet`. Safe to move here and nowhere
    // else — the fingerprint exists so a DEPENDENT can tell two packages with
    // one name apart, and nothing consumes this package; it is the root.
    .fingerprint = 0xe99ef3722015013c,
    .dependencies = .{
        // The fork adds split token usage, safe provider error details,
        // streamed tool-call assembly, and in-process libcurl for streaming
        // and buffered HTTP. Each request owns its transfer handles; a
        // configured proxy tunnels to the validated destination address.
        // `compat` is re-exported so explicit subprocess tools get a working
        // Zig 0.16 process Io. Fork releases are tagged on its `main` as
        // `agentsfleet-v<cut date>`, a name upstream's `vYYYY.M.D` tags and
        // its `v*` release workflow never match; the package `.version` stays
        // the upstream base. The `#<commit>` keeps the pin reproducible if a
        // tag moves. Return to an upstream tag once upstream carries these
        // patches.
        .nullclaw = .{
            .url = "git+https://github.com/agentsfleet/nullclaw.git?ref=agentsfleet-v2026.9.25#8a5804703fc60d9cc1134430a0583f820dc81bfe",
            .hash = "nullclaw-2026.5.29-wlZZyeYPSQGOCXsx2LMlFO2WfhntCaaof-q1rCA955x2",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "schema",
    },
}
