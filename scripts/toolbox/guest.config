# Merged over Firecracker's Continuous Integration (CI) configuration by
# guest.sh, which then refuses a kernel whose final configuration lacks any
# line it requires.

# The toolbox is the guest's first drive, an Enhanced Read-Only File System
# (EROFS) image compressed with LZ4; the CI configuration ships EROFS off.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y

# A tenant process must not gain capabilities in a user namespace of its own:
# the guest's executor is root and builds the inner environment from process
# and mount namespaces alone.
# CONFIG_USER_NS is not set

# Nothing in the guest loads a module, and the CI configuration builds none.
# CONFIG_MODULES is not set
