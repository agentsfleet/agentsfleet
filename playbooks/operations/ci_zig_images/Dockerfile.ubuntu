# syntax=docker/dockerfile:1.7
#
# Ubuntu 24.04 + Zig — host-runner replacement for unit/bench/qa/lint-zig
# lanes that today run bare on ubuntu-latest with mlugg/setup-zig. Includes
# docker-cli so it can also drive `docker compose` against a mounted
# /var/run/docker.sock from the test-integration lane (alternative is to
# convert that lane to GHA `services:` and skip docker-cli). kcov is built
# from a pinned upstream tarball — Ubuntu 24.04 (noble) dropped it from
# universe — for the Zig coverage lane (M143).
# amd64 only.

FROM mirror.gcr.io/library/ubuntu:24.04

ARG ZIG_VERSION
ARG ZIG_SHA256_X86_64_LINUX

RUN test -n "$ZIG_VERSION" && test -n "$ZIG_SHA256_X86_64_LINUX"

ENV DEBIAN_FRONTEND=noninteractive

# bubblewrap is production parity, not a convenience: the runtime image
# (/Dockerfile) installs it, and the runner spawns every sandboxed lease through
# `bwrap`. Without it here, each proof that needs a real binary resolved
# `error.BwrapUnavailable` and returned SkipZigTest — silently, on every run, in
# the only Linux environment those tests had. That is how a sandbox missing
# /run/systemd/resolve shipped and broke every lease for a week (M167).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libssl-dev \
      git \
      curl \
      wget \
      xz-utils \
      ca-certificates \
      make \
      python3 \
      build-essential \
      docker.io \
      docker-compose-v2 \
      gnupg \
      bubblewrap \
 && rm -rf /var/lib/apt/lists/*
# docker-compose-v2 is named explicitly because `docker.io` does NOT provide it.
# This image drives `docker compose up` against the mounted host socket from the
# test-integration lane, and the header below claimed docker-cli was enough for
# that — it is not, on Ubuntu 24.04. A rebuild from the unchanged Dockerfile
# therefore produced an image whose compose had silently vanished, and the lane
# died on `unknown shorthand flag: 'd' in -d`. Naming the package pins the
# capability to this file instead of to whatever `docker.io` happens to bundle.

RUN set -eux; \
    tarball="zig-x86_64-linux-${ZIG_VERSION}.tar.xz"; \
    for url in \
      "https://pkg.machengine.org/zig/${tarball}" \
      "https://zigmirror.hryx.net/zig/${tarball}" \
      "https://ziglang.org/download/${ZIG_VERSION}/${tarball}" ; do \
      echo "  fetching $url" ; \
      if wget -q "$url" -O /tmp/zig.tar.xz \
         && echo "${ZIG_SHA256_X86_64_LINUX}  /tmp/zig.tar.xz" | sha256sum -c - >/dev/null 2>&1 ; then \
        echo "  ✓ verified from $url" ; break ; \
      fi ; \
      rm -f /tmp/zig.tar.xz ; \
    done; \
    test -f /tmp/zig.tar.xz || { echo "FAIL: zig ${ZIG_VERSION} download failed from every mirror"; exit 1; }; \
    mkdir -p /opt ; \
    (cd /opt && tar xf /tmp/zig.tar.xz) ; \
    mv "/opt/zig-x86_64-linux-${ZIG_VERSION}" /opt/zig ; \
    rm /tmp/zig.tar.xz ; \
    /opt/zig/zig version

ENV PATH=/opt/zig:$PATH

# kcov — not packaged in noble; build the pinned v43 tarball from upstream.
# SHA256 is the trust anchor for the GitHub-generated source archive.
ARG KCOV_VERSION=43
ARG KCOV_SHA256=4cbba86af11f72de0c7514e09d59c7927ed25df7cebdad087f6d3623213b95bf

RUN set -eux; \
    apt-get update \
 && apt-get install -y --no-install-recommends \
      cmake \
      binutils-dev \
      libcurl4-openssl-dev \
      libdw-dev \
      libelf-dev \
      zlib1g-dev \
 && curl -fsSL "https://github.com/SimonKagstrom/kcov/archive/refs/tags/v${KCOV_VERSION}.tar.gz" -o /tmp/kcov.tar.gz \
 && echo "${KCOV_SHA256}  /tmp/kcov.tar.gz" | sha256sum -c - \
 && mkdir -p /tmp/kcov-src \
 && tar -xzf /tmp/kcov.tar.gz -C /tmp/kcov-src --strip-components=1 \
 && cmake -S /tmp/kcov-src -B /tmp/kcov-build -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /tmp/kcov-build --parallel "$(nproc)" \
 && cmake --install /tmp/kcov-build --prefix /usr/local \
 && rm -rf /tmp/kcov-src /tmp/kcov-build /tmp/kcov.tar.gz \
 && apt-get purge -y cmake \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/* \
 && kcov --version

LABEL org.opencontainers.image.title="agentsfleet ci-zig-ubuntu" \
      org.opencontainers.image.description="Ubuntu 24.04 + Zig — host-runner replacement for agentsfleet unit/bench/qa/lint-zig lanes" \
      org.opencontainers.image.source="https://github.com/agentsfleet/agentsfleet"
