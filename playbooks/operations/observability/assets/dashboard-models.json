  "panels": [
    {
      "id": 130,
      "title": "Model call rate",
      "type": "timeseries",
      "description": "Actual calls per second by provider and model, with daemon and runner separate.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model, gen_ai_provider_name) (rate(agentsfleet_model_call_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "Daemon \u00b7 {{gen_ai_provider_name}} \u00b7 {{gen_ai_request_model}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (gen_ai_request_model, gen_ai_provider_name) (rate(agentsfleet_runner_model_call_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "Runner \u00b7 {{gen_ai_provider_name}} \u00b7 {{gen_ai_request_model}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No samples",
          "links": [
            {
              "title": "Model traces",
              "url": "/explore?left={%22datasource%22%3A%22${tempo}%22%2C%22queries%22%3A%5B{%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22{%20name%20%3D%20%5C%22chat%5C%22%20}%22}%5D%2C%22range%22%3A{%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22}}",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 131,
      "title": "First text delay p95",
      "type": "timeseries",
      "description": "Time until the first nonempty model text; absent if no text arrived.",
