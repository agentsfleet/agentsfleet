      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(.95, sum by (le, gen_ai_request_model, gen_ai_provider_name) (rate(agentsfleet_model_first_token_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "Daemon \u00b7 {{gen_ai_provider_name}} \u00b7 {{gen_ai_request_model}}",
