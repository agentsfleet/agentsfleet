        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 112,
      "title": "Response time p95",
      "type": "timeseries",
      "description": "Request-to-response-header latency by route; excludes full streaming lifetime.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(.95, sum by (le, http_route) (rate(agentsfleet_api_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{http_route}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
