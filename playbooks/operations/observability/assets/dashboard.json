  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "description": "Share of valid attempts accepted or replayed; excludes over-budget refusals. The 99% target is not yet proven.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "id": 20,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(agentsfleet_admissions_total{outcome=~\"accepted|replayed\"}[$__range])) / sum(increase(agentsfleet_admissions_total{outcome!=\"over_budget\"}[$__range]))",
          "legendFormat": "availability",
          "refId": "A"
        }
      ],
      "title": "Request acceptance",
      "type": "stat"
    },
    {
      "id": 37,
      "type": "stat",
      "title": "Run success rate",
      "description": "Successfully processed executions divided by all recorded completed executions; includes platform and workload failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "instant": false,
          "legendFormat": "success",
          "expr": "sum(increase(agentsfleet_runner_executions_total{outcome=\"processed\"}[$__range])) / sum(increase(agentsfleet_runner_executions_total[$__range]))"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "description": "Age of the oldest accepted request still waiting, running or parked.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "id": 28,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max(agentsfleet_admission_backlog_oldest_age_seconds)",
          "legendFormat": "oldest unfinished request",
          "refId": "A"
        }
      ],
      "title": "Oldest unfinished request",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(agentsfleet_runner_executions_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(agentsfleet_runner_failures_total[$__rate_interval]))",
          "legendFormat": "failure: {{reason}}",
          "refId": "B"
        }
      ],
      "title": "Run results",
      "type": "timeseries",
      "description": "Execution outcomes and recorded failure reasons per second."
    },
    {
      "id": 101,
      "title": "Chat response p95 / p99",
      "type": "timeseries",
      "description": "Fleet-wide event-to-completion time at p95 and p99; excludes browser rendering.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(.95, sum by (le) (rate(agentsfleet_fleet_delivery_stage_seconds_bucket{stage=\"event_to_complete\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(.99, sum by (le) (rate(agentsfleet_fleet_delivery_stage_seconds_bucket{stage=\"event_to_complete\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
