      "targets": [
        {
          "expr": "(sum(rate(agentsfleet_runner_executions_total{outcome=\"fleet_error\", fault=\"platform\"}[1h])) / sum(rate(agentsfleet_runner_executions_total{fault!=\"workload\"}[1h]))) / 0.05",
          "legendFormat": "1h burn",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(agentsfleet_runner_executions_total{outcome=\"fleet_error\", fault=\"platform\"}[5m])) / sum(rate(agentsfleet_runner_executions_total{fault!=\"workload\"}[5m]))) / 0.05",
          "legendFormat": "5m burn",
          "refId": "B"
        },
        {
          "expr": "(sum(rate(agentsfleet_runner_executions_total{outcome=\"fleet_error\", fault=\"platform\"}[6h])) / sum(rate(agentsfleet_runner_executions_total{fault!=\"workload\"}[6h]))) / 0.05",
          "legendFormat": "6h burn",
          "refId": "C"
        },
        {
          "expr": "(sum(rate(agentsfleet_runner_executions_total{outcome=\"fleet_error\", fault=\"platform\"}[30m])) / sum(rate(agentsfleet_runner_executions_total{fault!=\"workload\"}[30m]))) / 0.05",
          "legendFormat": "30m burn",
          "refId": "D"
        }
      ],
      "title": "How fast we are burning the runner budget (target unproven)",
