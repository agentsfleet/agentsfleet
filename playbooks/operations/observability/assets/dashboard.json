  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "description": "Share of valid admission attempts accepted or replayed over the dashboard range. Target 99%, unproven. Compare failures with the valid-event count.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "id": 20,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(agentsfleet_admissions_total{outcome=~\"accepted|replayed\"}[$__range])) / sum(increase(agentsfleet_admissions_total{outcome!=\"over_budget\"}[$__range]))",
          "legendFormat": "availability",
          "refId": "A"
        }
      ],
      "title": "Admission success",
      "type": "stat"
    },
    {
      "id": 37,
      "type": "stat",
      "title": "Run success",
      "description": "The same ratio WITHOUT the blame split: every failure counted, including the ones the workload caused. This is what a customer feels \u2014 'did my run work' is a fair question with a real answer. It carries no target and nothing alerts on it, because an objective has to be a promise about something this platform controls. Read it beside the objective to its left: a wide gap between them is tenants shipping code that fails, not a platform regression.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "instant": false,
          "legendFormat": "all-cause success",
          "expr": "sum(increase(agentsfleet_runner_executions_total{outcome=\"processed\"}[$__range])) / sum(increase(agentsfleet_runner_executions_total[$__range]))"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "description": "Age of the oldest unsettled admission.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "id": 28,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max(agentsfleet_admission_backlog_oldest_age_seconds)",
          "legendFormat": "oldest unsettled admission",
          "refId": "A"
        }
      ],
      "title": "Oldest work",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(agentsfleet_runner_executions_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(agentsfleet_runner_failures_total[$__rate_interval]))",
          "legendFormat": "failure: {{reason}}",
          "refId": "B"
        }
      ],
      "title": "Run outcomes",
      "type": "timeseries",
      "description": "Execution outcomes per second, with failures broken out by reason underneath. This is where the runner success indicator at the top gets its explanation."
    },
    {
      "id": 101,
      "title": "Chat p95 / p99",
      "type": "timeseries",
      "description": "Fleet-wide event-to-complete latency; histogram estimates, continuously updated.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(.95, sum by (le) (rate(agentsfleet_fleet_delivery_stage_seconds_bucket{stage=\"event_to_complete\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(.99, sum by (le) (rate(agentsfleet_fleet_delivery_stage_seconds_bucket{stage=\"event_to_complete\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
