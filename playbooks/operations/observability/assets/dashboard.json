      "description": "Committed admissions awaiting settlement, including active and parked work. A sustained rise with flat lease starts calls for a placement or approval check."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "description": "Current count per lifecycle status, and a GAP when the census could not be read. The producer withdraws all five readings together when its query fails (`a_withdrawn_census_publishes_no_reading_at_all`), so absence here means the census, the exporter or the daemon is down \u2014 not that the fleet is empty. These queries carry no `or vector(0)` for exactly that reason: a zero would render an outage as five healthy zeroes. Not a rate; this is the standing population.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "id": 35,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "max(agentsfleet_fleets{status=\"installing\"})",
          "legendFormat": "installing",
          "refId": "A"
        },
        {
          "expr": "max(agentsfleet_fleets{status=\"active\"})",
          "legendFormat": "active",
          "refId": "B"
        },
        {
          "expr": "max(agentsfleet_fleets{status=\"paused\"})",
          "legendFormat": "paused",
          "refId": "C"
        },
        {
          "expr": "max(agentsfleet_fleets{status=\"stopped\"})",
          "legendFormat": "stopped",
          "refId": "D"
        },
        {
          "expr": "max(agentsfleet_fleets{status=\"killed\"})",
          "legendFormat": "killed",
          "refId": "E"
        }
      ],
      "title": "Fleets",
      "type": "stat"
    },
