  "panels": [
    {
      "id": 40,
      "title": "Round trip",
      "type": "stat",
      "description": "Select a Tempo datasource and a fleet ID. Percentiles cover up to 1,000 returned delivery spans in the dashboard time range, not every trace if the result is truncated. Missing segments have no samples; they are not zero. Segments overlap and must not be summed.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "queryType": "traceql",
          "query": "{ name = \"fleet.delivery\" && span.\"gen_ai.agent.id\" = \"$fleet_id\" }",
          "tableType": "spans",
          "limit": 1000,
          "spss": 1
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "duration"
              ]
            }
          }
        },
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "p95",
              "p99"
            ],
            "mode": "reduceFields"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "noValue": "No samples",
          "decimals": 2,
          "displayName": "${__field.labels.reducer}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": []
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
