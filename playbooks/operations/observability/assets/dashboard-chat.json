    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "id": 38,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate({__name__=~\"agentsfleet_fleet_delivery_stage_seconds.*\",le!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{stage}} p95",
          "refId": "A"
        }
      ],
      "title": "Delivery stages",
      "type": "timeseries",
      "description": "P95 seconds for each fixed stage, ending when the daemon receives the first intact runner chunk. Event stages begin at the producer event timestamp; lease stage begins when the lease row is written; zombie begins immediately before invoking the fleet execution engine. First chunk may contain reasoning or tool syntax. This is not browser first paint. A missing series means no completed stage was observed."
    },
    {
      "id": 102,
      "title": "Runner wakeups",
      "type": "timeseries",
      "description": "Ring is a wake for fresh work; capped means the held-heartbeat limit was reached.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(agentsfleet_runner_wake_answers_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 103,
      "title": "Memory delivery failures",
      "type": "timeseries",
      "description": "Failure signals; they do not count successful inline or fallback reads.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
