  "panels": [
    {
      "id": 150,
      "title": "Sandbox preparation results",
      "type": "timeseries",
      "description": "Background build outcomes: ready, preparation failure, checkout failure or stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(agentsfleet_runner_sandbox_builds_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No samples",
          "links": [
            {
              "title": "Run traces",
              "url": "/explore?left={%22datasource%22%3A%22${tempo}%22%2C%22queries%22%3A%5B{%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22{%20name%20%3D%20%5C%22runner.lease%5C%22%20}%22}%5D%2C%22range%22%3A{%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22}}",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
