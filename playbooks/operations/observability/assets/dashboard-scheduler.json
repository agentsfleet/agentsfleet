  "panels": [
    {
      "id": 120,
      "title": "Schedules",
      "type": "timeseries",
      "description": "Desired states, sync states and overdue one-shots overlap; do not add these series.",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (state) (agentsfleet_schedules)",
          "legendFormat": "{{state}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
