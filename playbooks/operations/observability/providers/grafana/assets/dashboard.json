    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "description": "What is being retried rather than failing outright. Admission replays are the sweeper re-appending rows the queue never took; repair dispatch retries are verifier dispatch attempts awaiting another pass; hub reconnects are pub/sub redials, and a spike there means datastore instability. Each of these is work the system is absorbing — a rising line is the warning before the failure, not the failure.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
