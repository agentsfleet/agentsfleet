+
+/// Scope dimensions repeat their target only inside a composite reference.
+/// The sole primary-id role below closes the task/checkpoint ownership cycle.
+fn key_names_match(table: &str, column: &str, target: &str, target_column: &str, arity: i32) -> bool {
+    if target_column == "id" {
+        column.ends_with("_id") && (column.ends_with(&format!("{}_id", singular(target)))
+            || ROLE_NAMED.contains(&(column, target)))
+    } else {
+        arity > 1 && (column == target_column
+            || (table == "tasks" && column == "id"
+                && target == "task_checkpoints" && target_column == "task_id"))
+    }
+}
+
+#[test]
+fn composite_scope_columns_preserve_target_identity() {
+    assert!(key_names_match("task_checkpoints", "task_base_id", "task_bases", "id", 1));
+    assert!(key_names_match("task_checkpoints", "repository", "task_bases", "repository", 3));
+    assert!(key_names_match("tasks", "id", "task_checkpoints", "task_id", 4));
+    assert!(!key_names_match("task_checkpoints", "base_id", "task_bases", "id", 1));
+    assert!(!key_names_match("task_checkpoints", "wrong_repository", "task_bases", "repository", 3));
+    assert!(!key_names_match("other_tasks", "id", "task_checkpoints", "task_id", 4));
+    assert!(!key_names_match("tasks", "id", "task_checkpoints", "other_task_id", 4));
+    assert!(!key_names_match("members", "email", "users", "email", 1));
+    assert!(!key_names_match("tasks", "id", "task_checkpoints", "task_id", 1));
+}
