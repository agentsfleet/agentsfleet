# Pinned inputs for the Rust CI base image. `build_and_push.sh` sources this.
#
# The Rust version is the repository's own pin — rust-toolchain.toml — and the
# two must agree: an image compiling with a different toolchain than the one
# every other lane uses is a second compiler nobody chose.
#
# The Alpine floor names a patch series rather than `alpine3`, so a major release
# cannot arrive unannounced. Within the series the tag still moves — 3.24 is
# 3.24.1 today and will become 3.24.2 — so the musl and gcc layer floats by
# patch. Pinning `alpine@sha256:` would close that and cost a commit per Alpine
# patch; `ci_zig_images` makes the same trade, and the compiler, which is the
# input that decides the shipped binary, is pinned exactly either way.
# Alpine is the base because it is musl natively, which is what a static binary
# for a distroless runtime needs.
RUST_VERSION=1.98.1
ALPINE_SERIES=3.24

# How the toolchain gets into the image. The base is plain Alpine and rustup
# installs RUST_VERSION into it, because docker-library's `rust:*-alpine` tags
# lag a rustc release by weeks — 1.98.1 shipped 2026-09-01 and the alpine
# variants were still on 1.98.0 — so a base named after the version cannot be
# built on the day the version is pinned. The bootstrap mirrors
# rust-lang/docker-rust's own `Dockerfile-alpine.template`, and it is the same
# shape `ci_zig_images` uses next door: a pinned installer plus a per-
# architecture SHA256.
#
# The checksums below are the ones UPSTREAM publishes at
# `<installer-url>.sha256`, not hashes of whatever a download happened to
# return. `fetch-shas` reads the published value, fetches the binary, and
# refuses when the two disagree — so a corrupted or tampered transfer fails
# loudly instead of being blessed as the new pin. A wholly compromised
# static.rust-lang.org could still serve a matching pair; only a signature
# would close that, and rustup publishes none.
#
# Regenerate with: ./build_and_push.sh fetch-shas
RUSTUP_VERSION=1.29.0
RUSTUP_SHA256_X86_64_MUSL=9cd3fda5fd293890e36ab271af6a786ee22084b5f6c2b83fd8323cec6f0992c1
RUSTUP_SHA256_AARCH64_MUSL=88761caacddb92cd79b0b1f939f3990ba1997d701a38b3e8dd6746a562f2a759
