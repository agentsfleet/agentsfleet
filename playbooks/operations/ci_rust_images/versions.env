# Pinned inputs for the Rust CI base image. `build_and_push.sh` sources this.
#
# The Rust version is the repository's own pin — rust-toolchain.toml — and the
# two must agree: an image compiling with a different toolchain than the one
# every other lane uses is a second compiler nobody chose.
#
# The Alpine floor is pinned to a patch series rather than `alpine3` so the base
# cannot move under a release. Alpine is the base because it is musl natively,
# which is what a static binary for a distroless runtime needs.
RUST_VERSION=1.98.0
ALPINE_SERIES=3.24
