# Pinned versions for the CI Rust base image.
#
# RUST_VERSION is NOT a free choice: it must equal the channel in
# `rustd/rust-toolchain.toml`, which is itself equal to the mise-managed Rust a
# developer shell resolves. Three places, one number, on purpose — a container
# whose compiler differs from the pin is the exact "works on my machine" this
# image exists to remove. `001_playbook.md` §Bumping carries the order.
#
# No SHA256s here, unlike the Zig images: `rustup-init` verifies its own
# downloads against the signed channel manifest, so pinning a hash of the
# installer would add a second checksum to maintain and no security this does
# not already have.

RUST_VERSION=1.98.0

# The runtime the TypeScript lanes and the repository's own tooling run on.
# Equal to the `bun-version` every workflow passes to `oven-sh/setup-bun`.
BUN_VERSION=1.4.0

# Pinned rather than floating because a scanner that changes behaviour between
# runs turns a green branch red with no diff to explain it.
GITLEAKS_VERSION=8.30.0
