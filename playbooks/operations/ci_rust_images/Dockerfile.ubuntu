# syntax=docker/dockerfile:1.7
#
# Ubuntu 24.04 + Rust — host-runner replacement for the `rustd` lanes that today
# run bare on ubuntu-latest and rebuild their toolchain and tools on every job.
#
# What this removes from each run, measured as steps rather than seconds: a
# rustup channel resolve, a `cargo install cargo-llvm-cov` (or the
# `taiki-e/install-action` download that stands in for it), a `setup-bun`
# download, and an apt fetch for the datastore client the integration lane
# drives. What it deliberately does NOT remove is compilation of the workspace
# itself — an image layer is immutable, so build artifacts cannot live here.
# That half is the cache's job (`001_playbook.md` §What this image is not for).
#
# amd64 only: every `runs-on` in this repository is `ubuntu-latest`, and a
# second architecture would double build time for an image nothing pulls.

FROM mirror.gcr.io/library/ubuntu:24.04

ARG RUST_VERSION
ARG BUN_VERSION
ARG GITLEAKS_VERSION

RUN test -n "$RUST_VERSION" && test -n "$BUN_VERSION" && test -n "$GITLEAKS_VERSION"

ENV DEBIAN_FRONTEND=noninteractive

# `build-essential` is the linker, not a convenience: rustc shells out to `cc`
# to link every binary, so a Rust image without it compiles and then fails at
# the last step with a message about `cc` that reads like a project defect.
#
# `docker.io` + `docker-compose-v2` are named separately for the reason the Zig
# image records: `docker.io` does not provide compose on Ubuntu 24.04, and the
# integration lane drives `docker compose up` for its Postgres and Redis.
#
# `postgresql-client` gives that same lane `psql` for the schema reset its make
# target performs before each run.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      git \
      gnupg \
      make \
      pkg-config \
      libssl-dev \
      unzip \
      xz-utils \
      docker.io \
      docker-compose-v2 \
      postgresql-client \
 && rm -rf /var/lib/apt/lists/*

# ── Rust ─────────────────────────────────────────────────────────────────
#
# Installed to a WORLD-READABLE location rather than a user home. A GitHub
# Actions job may run the container as an arbitrary uid, and a toolchain under
# /root is unreadable to every uid but one — which surfaces as "cargo: not
# found" on a machine that plainly has cargo.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

# The components mirror `rustd/rust-toolchain.toml` exactly: `rustfmt` and
# `clippy` because `make lint-all` runs both and a missing one must fail loudly
# rather than skip, and `llvm-tools` because it is what cargo-llvm-cov measures
# through.
RUN set -eux; \
    curl -fsSL --retry 3 https://sh.rustup.rs -o /tmp/rustup-init.sh; \
    sh /tmp/rustup-init.sh -y \
      --no-modify-path \
      --profile minimal \
      --default-toolchain "$RUST_VERSION" \
      --component rustfmt clippy llvm-tools; \
    rm -f /tmp/rustup-init.sh; \
    chmod -R a+rX,a+w "$CARGO_HOME" "$RUSTUP_HOME"; \
    rustc --version; \
    cargo --version

# `--locked` so the tool's own dependency resolution cannot drift between two
# builds of the same Dockerfile — the failure mode that made a rebuilt Zig image
# silently lose compose.
RUN set -eux; \
    cargo install --locked cargo-llvm-cov; \
    chmod -R a+rX "$CARGO_HOME"; \
    cargo llvm-cov --version

# ── Bun ──────────────────────────────────────────────────────────────────
#
# Same reasoning as Rust's location: installed under /usr/local so any uid the
# runner picks can execute it.
ENV BUN_INSTALL=/usr/local/bun \
    PATH=/usr/local/bun/bin:$PATH

RUN set -eux; \
    curl -fsSL --retry 3 https://bun.sh/install -o /tmp/bun-install.sh; \
    bash /tmp/bun-install.sh "bun-v${BUN_VERSION}"; \
    rm -f /tmp/bun-install.sh; \
    chmod -R a+rX "$BUN_INSTALL"; \
    bun --version

# ── gitleaks ─────────────────────────────────────────────────────────────
#
# The pre-commit and pre-push hooks both run it, and the operating model makes a
# clean gitleaks a precondition of every commit. A lane that cannot run it can
# only skip the check.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) asset="gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" ;; \
      arm64) asset="gitleaks_${GITLEAKS_VERSION}_linux_arm64.tar.gz" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/${asset}" \
      -o /tmp/gitleaks.tar.gz; \
    tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks; \
    rm -f /tmp/gitleaks.tar.gz; \
    chmod a+rx /usr/local/bin/gitleaks; \
    gitleaks version

# No `CARGO_TARGET_DIR`. An earlier cut set it to the empty string, which cargo
# rejects outright — "the target directory is set to an empty string in the
# CARGO_TARGET_DIR environment variable" — so every build in the image would
# have died on its first invocation while every `--version` smoke check in
# §3 still passed. Left unset, cargo uses the workspace's own `target/`, which
# is what the lanes and the cache both expect.
WORKDIR /work

LABEL org.opencontainers.image.title="agentsfleet ci-rust-ubuntu" \
      org.opencontainers.image.description="Ubuntu 24.04 with the pinned Rust toolchain, cargo-llvm-cov, bun and gitleaks for the rustd CI lanes." \
      org.opencontainers.image.source="https://github.com/agentsfleet/agentsfleet"
