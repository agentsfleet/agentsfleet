// Canonical agentsfleet tailnet policy. The Human applies this file in the
// Tailscale access-control console during founding step 02.
//
// tag:ci     — ephemeral GitHub Actions deployment nodes
// tag:worker — long-lived agentsfleet-runner hosts
//
// Tailscale Secure Shell (SSH) owns tailnet port 22 on runner hosts. Both the
// network grant and the SSH rule must allow the connection.
{
	"grants": [
		{
			"src": ["autogroup:member", "tag:ci"],
			"dst": ["tag:worker"],
			"ip":  ["tcp:22"],
		},
	],

	"ssh": [
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["tag:worker"],
			"users":  ["autogroup:nonroot", "root"],
		},
		{
			"action": "accept",
			"src":    ["tag:ci"],
			"dst":    ["tag:worker"],
			"users":  ["autogroup:nonroot"],
		},
	],

	// Tailscale evaluates these assertions when the Human saves the policy.
	"sshTests": [
		{
			"src":    "tag:ci",
			"dst":    ["tag:worker"],
			"accept": ["debian"],
			"deny":   ["root"],
		},
	],

	"tagOwners": {
		"tag:ci":     ["autogroup:admin"],
		"tag:worker": ["autogroup:admin"],
	},
}
